# ─────────────────────────────────────────────────────────────────────────────
# Nautical Nomads — environment variables (TEMPLATE)
#
# Copy to `.env.local` for local dev. NEVER commit real values.
# In production, set these in the Cloudflare dashboard (or `wrangler secret put`).
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (canonicals, sitemap, OG). Swap to the final domain at cutover.
NEXT_PUBLIC_SITE_URL="https://nautical-nomads.com"

# Search engine indexing — OPT-IN.
# UNSET (or anything other than "true") → robots.txt disallows all + meta
# robots noindex,nofollow + empty sitemap. Keeps the pre-launch hyphen domain
# (and preview deploys) out of Google.
# At the real cutover, set this to "true" in Cloudflare. Nothing else changes.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# Free-shipping threshold, in major currency units (e.g. 75 = £75). When set to a
# positive number, the cart shows a "spend £X more for free shipping" meter and
# checkout waives the shipping charge once the items subtotal clears it. Unset / 0
# disables the feature entirely (no messaging, no waiver).
# NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="75"

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase — service role (SERVER ONLY, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (transactional email — Session 01 verifies the sending domain)
RESEND_API_KEY="re_..."
RESEND_FROM="hello@nauticalnomads.com"
RESEND_SMOKE_TEST_TO="you@example.com"

# Shopify migration (Session 03)
# Static Admin API tokens were deprecated Jan 2026; the migration uses the
# OAuth client credentials grant — Client ID + Secret are exchanged for a
# short-lived Admin API token at run time.
SHOPIFY_STORE_DOMAIN="nauticalnomads.myshopify.com"
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# SHOPIFY_API_VERSION="2026-01"  # optional override
# MIGRATE_OVERRIDES="./shopify-overrides.json"  # optional manual provider map

# POD providers (Sessions 03 / 06 / 07)
PRINTFUL_API_KEY=""
PRINTIFY_API_KEY=""
# PRINTIFY_SHOP_ID=""  # required for cost lookups

# Stripe (Session 05)
STRIPE_SECRET_KEY=""               # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=""           # whsec_... — Stripe dashboard → Webhooks → endpoint
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""   # pk_test_... (unused for hosted Checkout; reserved)

# POD shipment webhook secrets (optional but recommended)
PRINTFUL_WEBHOOK_SECRET=""
PRINTIFY_WEBHOOK_SECRET=""

# Cron + admin alerts
CRON_SECRET=""                     # set on Cloudflare Cron Trigger calls
OWNER_ALERT_EMAIL=""               # where owner attention-needed emails go

# Anthropic + Make.com + Google Drive (Sessions 12 / 13)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""                 # optional; defaults to claude-sonnet-4-6
GOOGLE_SERVICE_ACCOUNT_JSON=""     # full JSON, single-line, of the service account key
GOOGLE_DRIVE_FOLDER_ID=""          # the Drive folder Photos live in

# ── Added in later sessions (kept here as a reference checklist) ──────────────
# Make.com + Anthropic (Sessions 12/13)
# MAKE_WEBHOOK_URL=""
# ANTHROPIC_API_KEY=""
